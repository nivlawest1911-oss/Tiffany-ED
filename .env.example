# 🦅 EdIntel Sovereign - Modular Architecture Environment Template
# -----------------------------------------------------------------
# Frontend Gateway: Vercel
# Sovereign Memory: Supabase (PostgreSQL)
# Sovereign Brain: Google Cloud (Vertex AI / Gemini)
# Command Center: GitHub

# ============================================
# 🏛️ SOVEREIGN MAINFRAME (Google Cloud)
# ============================================
# Project ID: edintel-sovereign-2027
GOOGLE_CLOUD_PROJECT=edintel-sovereign-2027
GOOGLE_GENAI_API_KEY=your_gemini_api_key_here

# ============================================
# 🧠 SOVEREIGN MEMORY (Supabase)
# ============================================
# Replaces legacy Firebase/Firestore for FERPA-grade data integrity
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ============================================
# ⚡ VERCEL EDGE GATEWAY
# ============================================
# KV (Redis) for Neural Caching
KV_URL=rediss://default:your_token@your_host.upstash.io:6379
KV_REST_API_URL=https://your_host.upstash.io
KV_REST_API_TOKEN=your_token_here

# Vercel Postgres (Optional secondary data layer)
POSTGRES_URL=postgresql://user:pass@host/db

# ============================================
# 🐙 COMMAND FEEDBACK (GitHub)
# ============================================
GITHUB_ACCESS_TOKEN=your_github_token_here
GITHUB_REPO_OWNER=your_org_or_username
GITHUB_REPO_NAME=edintel-app

# ============================================
# 🎨 AVATAR & MEDIA SYNTHESIS
# ============================================
HEYGEN_API_KEY=your_heygen_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# ============================================
# 🔐 AUTHENTICATION & SECURITY
# ============================================
JWT_SECRET=your_super_secret_min_32_chars
SESSION_SECRET=your_session_secret_min_32_chars

# ============================================
# 📊 ANALYTICS & MONITORING
# ============================================
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your_id_here

# ============================================
# 💳 SOVEREIGN VAULT (Stripe Billing)
# ============================================
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ============================================
# 🏛️ COMPLIANCE & PROTOCOLS
# ============================================
NEXT_PUBLIC_SITE_URL=https://edintel-prod-ready.vercel.app
COMPLIANCE_PROTOCOL=AL_CODE_290-8-9
TOGETHER_API_KEY=your_together_api_key
REPLICATE_API_TOKEN=your_replicate_token

# ============================================
# 🛡️ HUMAN RESIDENCY (Cloudflare Turnstile & IronShield Bot Gate)
# ============================================
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_site_key_here
TURNSTILE_SECRET_KEY=your_secret_key_here
BOTID_SECRET_KEY=your_botid_secret_key
IRONSHIELD_STRICT_MODE=false
INTERNAL_SERVICE_KEY=your_internal_service_key_for_cron_bypass

